<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.14</version>
    <relativePath/>
  </parent>

  <groupId>nl.showcase</groupId>
  <artifactId>order</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>order</name>
  <description>Order service — contract testing showcase</description>

  <properties>
    <java.version>21</java.version>
    <kotlin.version>2.1.0</kotlin.version>

    <!-- Pin-configuratie: enige bron van waarheid voor contractversies. Wordt via
         resource filtering in application.yml (info.contracts.*) geïnjecteerd en
         door ci/docker-build.sh (via ci/lib/pins.sh) als OCI-label meegegeven —
         nooit hardcoded dupliceren. -->
    <contracts.serves.order-create>1.0.0</contracts.serves.order-create>
    <contracts.serves.order-lookup>1.0.0</contracts.serves.order-lookup>
    <contracts.consumes.order-payment>1.0.0</contracts.consumes.order-payment>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-kotlin</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-reflect</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Onderdeel 2, consumerkant: WireMock-stub voor Payment + OpenApiValidationListener,
         valideert elk verzoek dat Order stuurt tegen contracts/order-payment/1.0.0/openapi.yaml.
         Trekt wiremock-jre8 mee — een volledig losstaande embedded stub-server, geen
         servlet-afhankelijkheid, dus geen conflict met Boot 3.5/Jakarta (zie CLAUDE.md) en geen
         versiebotsing met de Docker-WireMock 3.x die voor de SOAP-grens draait (gescheiden
         classpaths). -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>swagger-request-validator-wiremock-junit5</artifactId>
      <version>2.44.9</version>
      <scope>test</scope>
      <exclusions>
        <!-- De losse wiremock-jre8-jar trekt zijn Jetty-dependencies transitief binnen, en
             Spring Boot's BOM overschrijft een deel daarvan (jetty-server/-http/-io/-util/...)
             naar Jetty 12 (Jakarta) terwijl wiremock-jre8 zelf op Jetty 9.4 (javax) leunt —
             gemengde versies crashen met NoClassDefFoundError. De standalone/shaded variant
             hieronder relocate't zijn eigen Jetty-klassen en ontwijkt dit volledig. -->
        <exclusion>
          <groupId>com.github.tomakehurst</groupId>
          <artifactId>wiremock-jre8</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.github.tomakehurst</groupId>
      <artifactId>wiremock-jre8-standalone</artifactId>
      <version>2.35.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
    <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
    <!-- Gedeeld build-snippet (onderdeel 1, identiek in de drie backend-poms):
         filtert application.yml met @-delimiters zodat de contracts.*-properties
         hierboven in info.contracts.* terechtkomen, zonder Spring's eigen
         ${...}-placeholders te verstoren. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <useDefaultDelimiters>false</useDefaultDelimiters>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <configuration>
          <args>
            <arg>-Xjsr305=strict</arg>
          </args>
          <compilerPlugins>
            <plugin>spring</plugin>
          </compilerPlugins>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-allopen</artifactId>
            <version>${kotlin.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

</project>
