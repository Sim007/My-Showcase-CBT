{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "mf-notifications": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "mf-notifications:esbuild",
            "federationConfig": "./federation.config.js",
            "verbose": false
          },
          "configurations": {
            "production": { "target": "mf-notifications:esbuild:production" },
            "development": { "target": "mf-notifications:esbuild:development" }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:serve",
          "options": {
            "target": "mf-notifications:serve-original",
            "federationConfig": "./federation.config.js",
            "verbose": false
          },
          "configurations": {
            "production": { "target": "mf-notifications:serve-original:production" },
            "development": { "target": "mf-notifications:serve-original:development" }
          },
          "defaultConfiguration": "development"
        },
        "esbuild": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/mf-notifications",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js", "es-module-shims"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/assets"],
            "styles": [
              "src/styles.css",
              "node_modules/@angular/material/prebuilt-themes/indigo-pink.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "mf-notifications:esbuild",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": { "buildTarget": "mf-notifications:esbuild:production" },
            "development": { "buildTarget": "mf-notifications:esbuild:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
